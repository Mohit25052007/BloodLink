# ==========================================
# BloodLink — Environment Configuration Template
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bloodlink

# JWT Authentication
# Replace with a long random secret in your .env file
JWT_SECRET=super_secret_jwt_key_bloodlink_2026_dev_secure_random_change_me
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Initial Administrator Credentials (used by npm run create-admin)
ADMIN_EMAIL=admin@bloodlink.org
ADMIN_PASSWORD=AdminSecurePass123!
ADMIN_NAME=System Administrator
ADMIN_PHONE=9876543210

# Frontend API Base URL (used by Vite client during development)
VITE_API_BASE_URL=http://localhost:5000/api
